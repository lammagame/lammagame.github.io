{"id":"iraqproverbs","name":"أمثال عراقية","q":[["أكمل المثل العراقي: «إيد وحدة ما ...»","تصفّگ"],["أكمل المثل: «ابن الوز ...»","عوّام"],["أكمل المثل: «باب النجار ...»","مخلّع"],["أكمل المثل: «مثل الأطرش بـ ...»","الزفة"],["أكمل المثل: «اللي يريد الحلو ...»","يصبر على مرّه"],["أكمل المثل: «الجار قبل ...»","الدار"],["أكمل المثل العراقي: «الما يعرف الصگر ...»","يشويه"],["أكمل المثل: «يا ما تحت السواهي ...»","دواهي"],["أكمل المثل العراقي: «الطول طول النخلة ...»","والعقل عقل الصخلة"],["أكمل المثل العراقي: «تريد أرنب أخذ أرنب ...»","تريد غزال أخذ أرنب"],["أكمل المثل العراقي: «عرب وين ...»","طنبورة وين"],["أكمل المثل: «ذاك الطاس ...»","وذاك الحمام"],["أكمل المثل العراقي: «شيِّم المعيدي ...»","وأخذ عباته"],["أكمل المثل العراقي: «على حس الطبل ...»","خفّن يا رجليّه"],["أكمل المثل العراقي: «بعد ما شاب ...»","ودّوه للكتّاب"],["أكمل المثل: «اللي ما يشوف من الغربال ...»","أعمى"],["أكمل المثل العراقي: «حط راسه بين الروس ...»","وگال يا گطّاع الروس"],["أكمل المثل العراقي: «اللي ما يرضى بجزة ...»","يرضى بجزة وخروف"],["أكمل المثل العراقي: «أكل ومرعى ...»","وقلّة صنعة"],["أكمل المثل العراقي: «أحچي ويّاچ يا چنّة ...»","واسمعي يا جارة"],["أكمل المثل العراقي: «الولد ولد ...»","ولو حكم بلد"],["أكمل المثل العراقي: «يا غافلين ...»","إلكم الله"],["أكمل المثل: «اللي بيته من زجاج ...»","لا يرمي الناس بالحجار"],["أكمل المثل العراقي: «اللي ما يعرف تدابيره ...»","حنطته تاكل شعيره"]]}